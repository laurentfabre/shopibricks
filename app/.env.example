# Copy to .env for local development. Fill in YOUR_* values from your deployment.
# Native CLI/SDK OAuth supplies credentials. Do not add a PAT or client secret.
DATABRICKS_CONFIG_PROFILE=shopibricks-personal
DATABRICKS_HOST=https://YOUR-WORKSPACE.cloud.databricks.com
SHOPIBRICKS_MODEL=system.ai.gpt-oss-120b
SHOPIBRICKS_GATEWAY_API=mlflow
SHOPIBRICKS_CDC_ENABLED=false
SHOPIBRICKS_CATALOG=workspace
SHOPIBRICKS_SCHEMA=shopibricks
DATABRICKS_WAREHOUSE_ID=YOUR_WAREHOUSE_ID
PGHOST=YOUR_LAKEBASE_HOST
PGDATABASE=databricks_postgres
PGUSER=you@example.com
LAKEBASE_ENDPOINT=projects/YOUR_PROJECT/branches/production/endpoints/primary
PGSSLMODE=require
SHOPIBRICKS_PUBLIC_URL=http://localhost:8000
MLFLOW_EXPERIMENT_ID=YOUR_EXPERIMENT_ID
SHOPIBRICKS_TRACE_TABLE_PREFIX=workspace.shopibricks.agent_traces
MLFLOW_ASYNC_TRACE_LOGGING_RETRY_TIMEOUT=15
MLFLOW_TRACING_SQL_WAREHOUSE_ID=YOUR_WAREHOUSE_ID
SHOPIBRICKS_TRACE_VERIFY=0
SHOPIBRICKS_STREAM_JOB_ID=YOUR_STREAM_JOB_ID
SHOPIBRICKS_REFRESH_JOB_ID=YOUR_REFRESH_JOB_ID
SHOPIBRICKS_PIPELINE_ID=YOUR_PIPELINE_ID
SHOPIBRICKS_VECTOR_INDEX=workspace.shopibricks.products_index
SHOPIBRICKS_GENIE_SPACE_ID=YOUR_GENIE_SPACE_ID
